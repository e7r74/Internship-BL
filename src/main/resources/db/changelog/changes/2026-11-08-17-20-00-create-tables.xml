<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="create-table" author="yerkhan">
        <createTable tableName="t_course">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="text"/>
            <column name="created_time" type="timestamp"/>
            <column name="update_time" type="timestamp"/>
        </createTable>
        <createTable tableName="t_chapter">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="text"/>
            <column name="order" type="int"/>
            <column name="course_id" type="BIGINT">
                <constraints nullable="false"
                            foreignKeyName="fk_chapter_course"
                            referencedTableName="t_course"
                            referencedColumnNames="id"/>
            </column>
            <column name="created_time" type="timestamp"/>
            <column name="update_time" type="timestamp"/>
        </createTable>
        <createTable tableName="t_lesson">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="text"/>
            <column name="content" type="text"/>
            <column name="order" type="int"/>
            <column name="chapter_id" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="fk_lesson_chapter"
                             referencedTableName="t_chapter"
                             referencedColumnNames="id"/>
            </column>
            <column name="created_time" type="timestamp"/>
            <column name="update_time" type="timestamp"/>
        </createTable>
    </changeSet>
</databaseChangeLog>